# Google Analytics 4 Measurement ID (starts with G-)
# Leave empty to skip GA4 entirely.
VITE_GA4_ID=G-XXXXXXXXXX

# Meta / Facebook Pixel ID (starts with a number, e.g. 123456789)
# Leave empty to skip Meta Pixel entirely.
VITE_META_PIXEL_ID=123456789

# Google Search Console site-verification token (from the "google-site-verification"
# HTML tag in Search Console). Injected into <head> at build time. Leave empty to skip.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools site-verification token (from the "msvalidate.01" meta tag).
# Injected into <head> at build time. Leave empty to skip.
BING_SITE_VERIFICATION=

# ---- Product image CDN (issue: store images in S3, serve via CloudFront) ----
# Base URL for product photos that live in S3 (`products/...` keys). Defaults to
# the live site origin; set it when previewing from a staging origin.
VITE_CDN_URL=

# AWS credentials the Netlify functions use to sign image uploads and read S3.
# Set these in Netlify site settings (Build & deploy -> Environment). The bucket
# must allow CORS PUTs from the admin origin (see README.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# How long an unreferenced S3 image survives before orphan cleanup deletes it.
# Defaults to 30 minutes when unset.
ORPHAN_GRACE_MINUTES=30

# ---- Admin panel login (issue #18) ----
# ADMIN_TOKEN (set in Netlify site settings, NOT in this file) is the admin
# password checked by the admin-login function. On success it returns a
# short-lived session token signed with JWT_SECRET. All admin functions
# (presign-image, process-image, save-products) verify that token:
JWT_SECRET=changeme-long-random-string
# How long an admin session stays valid before sign-in is required again.
# Defaults to 12 hours when unset.
SESSION_TTL_HOURS=12