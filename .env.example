# Google Analytics 4 Measurement ID (starts with G-)
# Leave empty to skip GA4 entirely.
VITE_GA4_ID=G-XXXXXXXXXX

# Meta / Facebook Pixel ID (starts with a number, e.g. 123456789)
# Leave empty to skip Meta Pixel entirely.
VITE_META_PIXEL_ID=123456789

# Google Search Console site-verification token (from the "google-site-verification"
# HTML tag in Search Console). Injected into <head> at build time. Leave empty to skip.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools site-verification token (from the "msvalidate.01" meta tag).
# Injected into <head> at build time. Leave empty to skip.
BING_SITE_VERIFICATION=

# ---- Product image CDN (issue: store images in S3, serve via CloudFront) ----
# Base URL for product photos that live in S3 (`products/...` keys). Defaults to
# the live site origin; set it when previewing from a staging origin.
VITE_CDN_URL=

# ---- AWS admin API (issue #130) ----
# Base URL for all /api routes (Lambda + API Gateway). Find it with:
#   terraform -chdir=infra/environments/prod output -raw aws_api_url
# The value is injected at build time into both the admin panel and the contact
# form. Every backend route (login, history, rollback, presign, process-image,
# publish, submit-enquiry) lives behind this one URL.
VITE_AWS_API_URL=
# API key for the API Gateway usage plan. It ships in the public admin bundle by
# design: access control is the signed admin session (JWT_SECRET), not the key.
#   terraform -chdir=infra/environments/prod output -raw aws_api_key
VITE_AWS_API_KEY=

# AWS region used when running the Lambda handlers locally.
AWS_REGION=ap-south-1
S3_BUCKET=
ENQUIRIES_BUCKET=

# How long an unreferenced S3 image survives before orphan cleanup deletes it.
# Defaults to 30 minutes when unset.
ORPHAN_GRACE_MINUTES=30

# ---- Admin panel login (issue #18) ----
# These secrets are stored as SSM SecureStrings by infra/scripts/set-secrets.sh,
# NOT in this file. ADMIN_TOKEN is the password checked by /api/admin-login; on
# success it returns a session token signed with JWT_SECRET. All admin routes
# verify that token.
# ADMIN_TOKEN=
# JWT_SECRET=changeme-long-random-string
# How long an admin session stays valid before sign-in is required again.
# Defaults to 12 hours when unset.
SESSION_TTL_HOURS=12

# ---- GitHub repo the publish/history/rollback routes write to (issue #20) ----
# GITHUB_TOKEN and GITHUB_REPO are stored as SSM parameters (the token via
# set-secrets.sh, the repo via Terraform). The values below are for local runs.
GITHUB_REPO=ganesh-159th/Riddhi-Siddhi-Gift-Pack
# GITHUB_TOKEN=ghp_...
