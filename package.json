{
  "name": "riddhi-siddhi-gift-pack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-images.mjs && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "build:lambda": "node scripts/build-lambda.mjs",
    "og-image": "node scripts/generate-og-image.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:e2e": "playwright test tests/e2e/admin-responsive.spec.js tests/e2e/landing.spec.js tests/e2e/admin-crud.spec.js",
    "test:admin": "playwright test tests/e2e/admin-responsive.spec.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  }
}
