{
  "name": "riddhi-siddhi-gift-pack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-images.mjs && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "og-image": "node scripts/generate-og-image.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
