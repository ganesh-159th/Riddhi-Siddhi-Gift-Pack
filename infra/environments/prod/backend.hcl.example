# Copy to backend.hcl and fill in the values from `infra/bootstrap` outputs,
# then run: terraform init -backend-config=backend.hcl
#
# Example:
#   bucket         = "riddhi-terraform-state-352329341119"
#   key            = "riddhi-site/prod/terraform.tfstate"
#   region         = "ap-south-1"
#   dynamodb_table = "terraform-state-lock"
#   encrypt        = true

bucket         = "riddhi-terraform-state-352329341119"
key            = "riddhi-site/prod/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "terraform-state-lock"
encrypt        = true